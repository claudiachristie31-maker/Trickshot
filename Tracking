-- For your own Roblox Studio game

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local enabled = false
local maxRange = 250

local gui = Instance.new("ScreenGui")
gui.Name = "NickoyAutoTracker"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(265, 155)
frame.Position = UDim2.new(0.05, 0, 0.35, 0)
frame.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius =
    UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 36)
title.BackgroundColor3 = Color3.fromRGB(55, 90, 180)
title.Text = "[made by Nickoy] Auto Tracker"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 15
title.Parent = frame

local toggle = Instance.new("TextButton")
toggle.Size = UDim2.new(1, -20, 0, 38)
toggle.Position = UDim2.fromOffset(10, 46)
toggle.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
toggle.Text = "AUTO TRACK: OFF"
toggle.TextColor3 = Color3.new(1, 1, 1)
toggle.TextSize = 15
toggle.Parent = frame

Instance.new("UICorner", toggle).CornerRadius =
    UDim.new(0, 7)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 45)
status.Position = UDim2.fromOffset(10, 94)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.new(1, 1, 1)
status.TextSize = 13
status.TextWrapped = true
status.Text = "Tracking disabled"
status.Parent = frame

local function nearestPlayer()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local best, bestDistance = nil, maxRange

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local otherChar = other.Character
            local otherRoot = otherChar
                and otherChar:FindFirstChild("HumanoidRootPart")
            local hum = otherChar
                and otherChar:FindFirstChildOfClass("Humanoid")

            if otherRoot and hum and hum.Health > 0 then
                local distance =
                    (otherRoot.Position - root.Position).Magnitude

                if distance < bestDistance then
                    best = other
                    bestDistance = distance
                end
            end
        end
    end

    return best, bestDistance
end

toggle.Activated:Connect(function()
    enabled = not enabled

    toggle.Text = enabled and "AUTO TRACK: ON"
        or "AUTO TRACK: OFF"

    toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(35, 155, 85)
        or Color3.fromRGB(170, 55, 55)

    status.Text = enabled
        and "Searching for nearest player..."
        or "Tracking disabled"
end)

RunService.RenderStepped:Connect(function()
    if not enabled then return end

    local target, distance = nearestPlayer()

    if target then
        status.Text = "Target: " .. target.Name
            .. "\nDistance: " .. math.floor(distance) .. " studs"
    else
        status.Text = "No player in range"
    end
end)
