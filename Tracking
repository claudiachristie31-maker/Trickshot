        or Color3.fromRGB(75, 55, 105)

    target = tracking and getNearestTarget() or nil
end)

-- Slider interaction: mouse and touch
local dragging = false

local function updateSlider(input)
    local width = sliderBack.AbsoluteSize.X
    if width <= 0 then
        return
    end

    local relativeX = math.clamp(
        (input.Position.X - sliderBack.AbsolutePosition.X) / width,
        0.05,
        1
    )

    strength = relativeX
    sliderFill.Size = UDim2.new(strength, 0, 1, 0)
    strengthLabel.Text = "TRACKING STRENGTH: "
        .. math.floor(strength * 100) .. "%"
end

sliderButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        updateSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Camera tracking
RunService:BindToRenderStep(
    TRACK_NAME,
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if not tracking then
            return
        end

        if not target
            or not target.Parent
            or not target:IsDescendantOf(workspace) then
            target = getNearestTarget()
        end

        if not target then
            return
        end

        local currentCamera = workspace.CurrentCamera
        if not currentCamera then
            return
        end

        currentCamera.CFrame = currentCamera.CFrame:Lerp(
            CFrame.lookAt(
                currentCamera.CFrame.Position,
                target.Position
            ),
            math.clamp(strength, 0.05, 1)
        )
    end
)

-- Cleanup
script.Destroying:Connect(function()
    RunService:UnbindFromRenderStep(TRACK_NAME)

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    for otherPlayer in pairs(espObjects) do
        removeESP(otherPlayer)
    end

    if gui then
        gui:Destroy()
    end
end)
