-- Handle respawns and new players
local function watchPlayer(otherPlayer)
    if otherPlayer == player then
        return
    end

    table.insert(connections, otherPlayer.CharacterAdded:Connect(function()
        task.wait(1)

        if espEnabled then
            createESP(otherPlayer)
        end
    end))
end

for _, otherPlayer in ipairs(Players:GetPlayers()) do
    watchPlayer(otherPlayer)
end

table.insert(connections, Players.PlayerAdded:Connect(watchPlayer))

table.insert(connections, Players.PlayerRemoving:Connect(function(otherPlayer)
    removeESP(otherPlayer)
end))

