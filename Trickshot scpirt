local state = {
    HeadLockDemo = false,
    FOV = 120,
    TargetPart = "Head",
    CircleVisible = true,
    Smoothness = 0.15,
}
local function makeButton(text, order, callback)
    local button = Instance.new("TextButton")
    button.LayoutOrder = order
    button.Size = UDim2.new(1, -6, 0, 48)
    button.BackgroundColor3 = Color3.fromRGB(42, 42, 47)
    button.TextColor3 = Color3.fromRGB(245, 245, 245)
    button.TextSize = 15
    button.Font = Enum.Font.GothamSemibold
    button.Text = text
    button.Parent = content
    Instance.new("UICorner", button).CornerRadius =
        UDim.new(0, 6)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(75, 75, 80)
    stroke.Parent = button
    button.Activated:Connect(function()
        callback(button)
    end)
    return button
end
makeButton("Head Lock Demo: OFF", 1, function(button)
    state.HeadLockDemo = not state.HeadLockDemo
    button.Text = state.HeadLockDemo
        and "Head Lock Demo: ON"
        or "Head Lock Demo: OFF"
    button.BackgroundColor3 = state.HeadLockDemo
        and Color3.fromRGB(135, 25, 38)
        or Color3.fromRGB(42, 42, 47)
end)
makeButton("FOV: 120 | Change", 2, function(button)
    state.FOV += 20
    if state.FOV > 300 then
        state.FOV = 60
    end
    button.Text = "FOV: " .. state.FOV .. " | Change"
end)
makeButton("Target Part: Head", 3, function(button)
    state.TargetPart = state.TargetPart == "Head"
        and "HumanoidRootPart"
        or "Head"
    button.Text = "Target Part: " .. state.TargetPart
end)
makeButton("FOV Circle: ON", 4, function(button)
    state.CircleVisible = not state.CircleVisible
    button.Text = state.CircleVisible
        and "FOV Circle: ON"
        or "FOV Circle: OFF"
end)
makeButton("Smoothness: 0.15 | Change", 5, function(button)
    state.Smoothness += 0.10
    if state.Smoothness > 0.50 then
        state.Smoothness = 0.05
    end
    button.Text = string.format(
        "Smoothness: %.2f | Change",
        state.Smoothness
    )
end)
