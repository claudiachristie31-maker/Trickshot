local function makeButton(text, order, callback)
    local button = Instance.new("TextButton")
    button.LayoutOrder = order
    button.Size = UDim2.new(1, 0, 0, 36)
    button.BackgroundColor3 = Color3.fromRGB(42, 42, 47)
    button.TextColor3 = Color3.fromRGB(245, 245, 245)
    button.TextSize = 13
    button.Font = Enum.Font.GothamSemibold
    button.Text = text
    button.AutoButtonColor = true
    button.Parent = content

    Instance.new("UICorner", button).CornerRadius =
        UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(75, 75, 80)
    stroke.Thickness = 1
    stroke.Parent = button

    button.Activated:Connect(function()
        callback(button)
    end)

    return button
end

-- FOV circle visual
local circle = Instance.new("Frame")
circle.Name = "FOVCircle"
circle.AnchorPoint = Vector2.new(0.5, 0.5)
circle.Position = UDim2.fromScale(0.5, 0.5)
circle.Size = UDim2.fromOffset(settings.FOV * 2,
    settings.FOV * 2)
circle.BackgroundTransparency = 1
circle.Visible = true
circle.Parent = gui

Instance.new("UICorner", circle).CornerRadius =
    UDim.new(1, 0)

local circleStroke = Instance.new("UIStroke")
circleStroke.Color = Color3.fromRGB(255, 45, 60)
circleStroke.Thickness = 1.5
circleStroke.Transparency = 0.15
circleStroke.Parent = circle

local function updateCircle()
    local viewport = workspace.CurrentCamera.ViewportSize
    local diameter = math.min(settings.FOV * 2,
        math.min(viewport.X, viewport.Y) - 10)

    circle.Size = UDim2.fromOffset(diameter, diameter)
end

